<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets us check whether the Google Maps app is installed for directions (Android 11+). -->
    <queries>
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:name=".ConsensusApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Consensus">

        <!-- Injected from local.properties by the Secrets Gradle Plugin. Never hard-code it. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_id" />

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.trips.TripsActivity" />
        <activity
            android:name=".ui.trips.CreateTripActivity"
            android:parentActivityName=".ui.trips.TripsActivity" />
        <activity
            android:name=".ui.overview.TripOverviewActivity"
            android:parentActivityName=".ui.trips.TripsActivity" />
        <activity
            android:name=".ui.preferences.PreferencesActivity"
            android:parentActivityName=".ui.overview.TripOverviewActivity" />
        <activity
            android:name=".ui.itinerary.ItineraryActivity"
            android:parentActivityName=".ui.overview.TripOverviewActivity" />
        <activity
            android:name=".ui.itinerary.ActivityEditActivity"
            android:parentActivityName=".ui.itinerary.ItineraryActivity" />
        <activity
            android:name=".ui.expenses.ExpensesActivity"
            android:parentActivityName=".ui.overview.TripOverviewActivity" />
        <activity
            android:name=".ui.expenses.AddExpenseActivity"
            android:parentActivityName=".ui.expenses.ExpensesActivity" />
        <activity
            android:name=".ui.expenses.SettleUpActivity"
            android:parentActivityName=".ui.expenses.ExpensesActivity" />
        <activity
            android:name=".ui.chat.ChatActivity"
            android:parentActivityName=".ui.overview.TripOverviewActivity"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".notifications.ConsensusMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
